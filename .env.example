# Houston AI Watchdog — Environment Variables
# Copy this file to .env and fill in the values you need.
# All values are optional — the system runs fully in demo mode without them.

# Optional: use real OpenAI embeddings instead of deterministic hash vectors
# OPENAI_API_KEY=sk-...

# Optional: real Auth0 JWT verification
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_AUDIENCE=https://api.houston-watchdog.ai

# Backend server settings (defaults shown)
# HOST=0.0.0.0
# PORT=8000

# Frontend settings
# VITE_API_BASE=http://localhost:8000
